LER_HOST=0.0.0.0
LER_PORT=8000
LER_MODEL_VARIANT=layout
LER_BASE_MODEL=indobenchmark/indobert-base-p1
LER_NER_MODEL=treamyracle/indobert-ner-gold
LER_CONFIDENCE_THRESHOLD=0.5
LER_MAX_TEXT_CHARS=50000

# OCR hanya untuk PDF hasil scan; sangat lambat di CPU
LER_ENABLE_OCR=false
# Preload model saat startup supaya request pertama tidak timeout
LER_WARMUP=true
