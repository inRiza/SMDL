generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  owner
  viewer
  auditor
}

enum DocumentVisibility {
  public
  organization
}

enum DocumentStatus {
  processing
  ready
  ler_failed
}

enum FileFormat {
  pdf
  docx
}

enum DocumentCategory {
  agreement
  contract
  policy
  other
}

enum DocumentSort {
  newest
  oldest
  title_asc
  title_desc
}

enum OrganizationSort {
  newest
  oldest
  name_asc
  name_desc
}

enum OrganizationType {
  unit_kerja
  divisi
  vendor
  mitra
}

enum OrganizationMemberStatus {
  pending
  accepted
  declined
}

enum OrganizationAccessLevel {
  owner
  member
  viewer
}

enum TellsMessageRole {
  user
  assistant
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @default("") @map("name")
  email        String    @unique @map("email")
  passwordHash String    @map("password_hash")
  role         UserRole  @default(viewer)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  sessions      Session[]
  organizations Organization[]
  organizationMemberships OrganizationMember[]

  @@index([email])
  @@index([name])
  @@map("users")
}

model Organization {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  description String?
  type        OrganizationType @default(unit_kerja)
  ownerId     String           @map("owner_id") @db.Uuid
  owner       User                 @relation(fields: [ownerId], references: [id])
  documents   Document[]
  members     OrganizationMember[]
  activities  OrganizationActivity[]
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@index([name])
  @@index([type])
  @@index([createdAt])
  @@index([ownerId])
  @@map("organizations")
}

model OrganizationMember {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  userId         String?                  @map("user_id") @db.Uuid
  email          String
  accessLevel    OrganizationAccessLevel    @default(member) @map("access_level")
  status         OrganizationMemberStatus @default(pending)
  invitedById    String                   @map("invited_by_id") @db.Uuid
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
  @@map("organization_members")
}

model OrganizationActivity {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorId        String?      @map("actor_id") @db.Uuid
  actorName      String       @map("actor_name")
  action         String
  summary        String
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("organization_activities")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Document {
  id             String          @id @default(uuid()) @db.Uuid
  title          String
  description    String?
  category       String?
  fileFormat     FileFormat      @map("file_format")
  fileSizeBytes  BigInt          @map("file_size_bytes")
  status         DocumentStatus     @default(processing)
  visibility     DocumentVisibility @default(public) @map("visibility")
  storageKey     String             @map("storage_key")
  ownerId        String          @map("owner_id") @db.Uuid
  chunks         DocumentChunk[]
  organizationId String?         @map("organization_id") @db.Uuid
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([title])
  @@index([category])
  @@index([status])
  @@index([visibility])
  @@index([organizationId])
  @@index([createdAt])
  @@map("documents")
}

model DocumentChunk {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  chunkIndex Int      @map("chunk_index")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")
  document   Document @relation(fields: [documentId], references: [id])

  @@index([documentId])
  @@map("document_chunks")
}

model TellsChat {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  title     String?
  messages  TellsChatMessage[]
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@map("tells_chats")
}

model TellsChatMessage {
  id          String           @id @default(uuid()) @db.Uuid
  tellsChatId String           @map("tells_chat_id") @db.Uuid
  role        TellsMessageRole
  content     String
  citations   Json?
  createdAt   DateTime         @default(now()) @map("created_at")
  tellsChat   TellsChat        @relation(fields: [tellsChatId], references: [id], onDelete: Cascade)

  @@index([tellsChatId, createdAt])
  @@map("tells_chat_messages")
}
