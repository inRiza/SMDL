generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  owner
  viewer
  auditor
}

enum UserAccountStatus {
  active
  deactivated
  deleted
}

enum DocumentVisibility {
  public
  organization
}

enum DocumentStatus {
  processing
  ready
  ler_failed
}

enum FileFormat {
  pdf
  docx
}

enum DocumentCategory {
  agreement
  contract
  policy
  other
}

enum DocumentSort {
  newest
  oldest
  title_asc
  title_desc
}

enum OrganizationSort {
  newest
  oldest
  name_asc
  name_desc
}

enum OrganizationType {
  unit_kerja
  divisi
  vendor
  mitra
}

enum OrganizationMemberStatus {
  pending
  accepted
  declined
}

enum OrganizationAccessLevel {
  owner
  member
  viewer
}

enum TellsMessageRole {
  user
  assistant
}

enum AuditEventStatus {
  success
  failure
}

enum OutboxStatus {
  pending
  published
  failed
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @default("") @map("name")
  email        String    @unique @map("email")
  passwordHash String    @map("password_hash")
  role          UserRole           @default(viewer)
  accountStatus UserAccountStatus  @default(active) @map("account_status")
  deactivatedAt DateTime?          @map("deactivated_at")
  deletedAt     DateTime?          @map("deleted_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  sessions      Session[]
  organizations Organization[]
  organizationMemberships OrganizationMember[]
  documents     Document[]

  @@index([email])
  @@index([name])
  @@index([accountStatus])
  @@map("users")
}

model Organization {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  description String?
  type        OrganizationType @default(unit_kerja)
  ownerId     String           @map("owner_id") @db.Uuid
  owner       User                 @relation(fields: [ownerId], references: [id])
  documents   Document[]
  members     OrganizationMember[]
  activities  OrganizationActivity[]
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@index([name])
  @@index([type])
  @@index([createdAt])
  @@index([ownerId])
  @@map("organizations")
}

model OrganizationMember {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  userId         String?                  @map("user_id") @db.Uuid
  email          String
  accessLevel    OrganizationAccessLevel    @default(member) @map("access_level")
  status         OrganizationMemberStatus @default(pending)
  invitedById    String                   @map("invited_by_id") @db.Uuid
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
  @@map("organization_members")
}

model OrganizationActivity {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorId        String?      @map("actor_id") @db.Uuid
  actorName      String       @map("actor_name")
  action         String
  summary        String
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("organization_activities")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Document {
  id             String             @id @default(uuid()) @db.Uuid
  title          String
  description    String?
  category       String?
  documentType   String?            @map("document_type")
  contentArea    String?            @map("content_area")
  classification String?
  publishedAt    DateTime?          @map("published_at") @db.Date
  revision       String?
  legalStatus    String?            @map("legal_status")
  source         String?
  fileFormat     FileFormat         @map("file_format")
  fileSizeBytes  BigInt             @map("file_size_bytes")
  status         DocumentStatus     @default(processing)
  visibility     DocumentVisibility @default(public) @map("visibility")
  storageKey     String             @map("storage_key")
  ownerId        String             @map("owner_id") @db.Uuid
  owner          User               @relation(fields: [ownerId], references: [id])
  chunks         DocumentChunk[]
  entities       DocumentEntity[]
  sections       DocumentSection[]
  activities     DocumentActivity[]
  organizationId String?            @map("organization_id") @db.Uuid
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  lerExtractedAt DateTime?          @map("ler_extracted_at")
  createdAt      DateTime           @default(now()) @map("created_at")

  @@index([title])
  @@index([ownerId])
  @@index([category])
  @@index([documentType])
  @@index([contentArea])
  @@index([status])
  @@index([visibility])
  @@index([organizationId])
  @@index([createdAt])
  @@map("documents")
}

model DocumentEntity {
  id          String   @id @default(uuid()) @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  entityType  String   @map("entity_type")
  entityValue String   @map("entity_value")
  confidence  Float?
  sourceText  String?  @map("source_text")
  createdAt   DateTime @default(now()) @map("created_at")
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_entities")
}

model DocumentSection {
  id           String   @id @default(uuid()) @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  orderIndex   Int      @map("order_index")
  blockType    String   @map("block_type")
  headingLevel Int      @default(0) @map("heading_level")
  pageNumber   Int      @default(0) @map("page_number")
  content      String
  createdAt    DateTime @default(now()) @map("created_at")
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, orderIndex])
  @@map("document_sections")
}

model DocumentActivity {
  id         String    @id @default(uuid()) @db.Uuid
  documentId String?   @map("document_id") @db.Uuid
  actorId    String?   @map("actor_id") @db.Uuid
  actorName  String    @map("actor_name")
  action     String
  summary    String
  metadata   Json?
  createdAt  DateTime  @default(now()) @map("created_at")
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
  @@index([createdAt])
  @@map("document_activities")
}

model DocumentChunk {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  chunkIndex Int      @map("chunk_index")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_chunks")
}

model TellsChat {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  title     String?
  messages  TellsChatMessage[]
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@map("tells_chats")
}

model TellsChatMessage {
  id          String           @id @default(uuid()) @db.Uuid
  tellsChatId String           @map("tells_chat_id") @db.Uuid
  role        TellsMessageRole
  content     String
  citations   Json?
  createdAt   DateTime         @default(now()) @map("created_at")
  tellsChat   TellsChat        @relation(fields: [tellsChatId], references: [id], onDelete: Cascade)

  @@index([tellsChatId, createdAt])
  @@map("tells_chat_messages")
}

model AuditEvent {
  id            String           @id @default(uuid()) @db.Uuid
  eventId       String           @unique @map("event_id")
  eventType     String           @map("event_type")
  service       String           @default("smdl-api")
  userId        String?          @map("user_id") @db.Uuid
  userEmail     String?          @map("user_email")
  userName      String?          @map("user_name")
  aggregateId   String?          @map("aggregate_id")
  aggregateType String?          @map("aggregate_type")
  requestId     String?          @map("request_id")
  ipAddress     String?          @map("ip_address")
  status        AuditEventStatus @default(success)
  summary       String
  payload       Json?
  metadata      Json?
  occurredAt    DateTime         @default(now()) @map("occurred_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  @@index([occurredAt(sort: Desc), id(sort: Desc)])
  @@index([eventType, occurredAt(sort: Desc)])
  @@index([userId, occurredAt(sort: Desc)])
  @@map("audit_events")
}

model OutboxEvent {
  id           String       @id @default(uuid()) @db.Uuid
  eventId      String       @unique @map("event_id")
  topic        String       @default("app.events")
  partitionKey String?      @map("partition_key")
  payload      Json
  status       OutboxStatus @default(pending)
  attempts     Int          @default(0)
  lastError    String?      @map("last_error")
  publishedAt  DateTime?    @map("published_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @unique @map("event_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_events")
}
